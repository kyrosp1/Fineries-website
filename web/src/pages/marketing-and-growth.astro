---
import CapabilityPage from "../components/CapabilityPage.astro";
import { getHomeBundle } from "../lib/wp.js";
import { getCapabilityServices } from "../data/capabilities.js";
const { home, settings, services } = await getHomeBundle();
const page = {
  prefix: "mg", name: "Marketing & Growth", accent: "gold",
  heroHeading: "Attention is only the beginning.",
  heroBody: "<p>Getting noticed matters.</p><p>But the real opportunity is turning attention into interest, interest into action and action into growth.</p>",
  introEyebrow: "The Opportunity", introHeading: "Reach the right people. Give them a reason to act.",
  introBody: "<p>We combine strategy, creative thinking, content, media and data to build marketing programmes designed around what the business actually needs to achieve.</p>",
  servicesHeading: "Turn attention into measurable growth.",
  services: getCapabilityServices("02"),
  principleEyebrow: "Our Thinking", principleHeading: "Don't just chase attention.",
  principleBody: "<p>Build demand. Build relevance. Build preference. Build a reason to choose.</p>", steps: [],
  seoDescription: "Integrated marketing strategy, campaigns, content, media and performance programmes designed to turn attention into measurable growth."
};
---
<CapabilityPage home={home} settings={settings} services={services} page={page} />
