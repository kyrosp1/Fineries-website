---
import CapabilityPage from "../components/CapabilityPage.astro";
import { getHomeBundle } from "../lib/wp.js";
import { getCapabilityServices } from "../data/capabilities.js";
const { home, settings, services } = await getHomeBundle();
const page = {
  prefix: "cp", name: "Content & Production", accent: "magenta",
  heroHeading: "Make something worth noticing.",
  heroBody: "<p>There's more content in the world than anyone could possibly consume.</p><p>Making more isn't the answer. Making something worth someone's attention is.</p>",
  introEyebrow: "Our Approach", introHeading: "Ideas first. Production second.",
  introBody: "<p>We don't begin with the camera. We begin with what needs to be communicated, who needs to care and what could make them stop.</p><p>Then we find the right way to bring the idea to life.</p>",
  servicesHeading: "What we create.",
  services: getCapabilityServices("03"),
  principleEyebrow: "From Thought to Impact", principleHeading: "Think. Make. Move.", principleBody: "<p>One connected team carries the idea from strategy through production and into the world.</p>",
  steps: [{title:"Think",description:"Strategy and creative concept."},{title:"Make",description:"Production, design, writing and technology."},{title:"Move",description:"Distribution, optimisation and amplification."}],
  seoDescription: "Creative direction, campaigns, video, photography, motion, social content and copywriting built around ideas worth noticing."
};
---
<CapabilityPage home={home} settings={settings} services={services} page={page} />
