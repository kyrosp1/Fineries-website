---
import SiteNav from "./SiteNav.astro";
import SiteFooter from "./SiteFooter.astro";
import { resolveSubservices } from "../data/capabilities.js";
const { home = {}, settings = {}, services = [] } = Astro.props;
const ctaWords = home.cta_words && home.cta_words.length ? home.cta_words : ["a brand", "a product", "content"];
const heroImg = home.hero_image || "";
const fallbackMediaBase = "https://cms.fineries.net/wp-content/plugins/fineries-cms/assets/media";
const brandHeroVideo = home.bs_hero_video_desktop || `${fallbackMediaBase}/web-app-hero-landscape.mp4`;
const brandHeroVideoMobile = home.bs_hero_video_mobile || `${fallbackMediaBase}/web-app-hero-mobile.mp4`;
const brandHeroPoster = home.bs_hero_poster || `${fallbackMediaBase}/web-app-hero-poster.png`;

const navItems = (settings.nav_items && settings.nav_items.length) ? settings.nav_items : [
  { label: "Home", link: "/" }, { label: "What We Do", link: "/what-we-do" },
  { label: "Work", link: "#" }, { label: "About", link: "#" },
  { label: "Insights", link: "#" }, { label: "Contact", link: "#contact" },
];
const companyLinks = (settings.footer_company_links && settings.footer_company_links.length) ? settings.footer_company_links : [
  { label: "About", link: "#" }, { label: "Work", link: "#" }, { label: "Insights", link: "#" }, { label: "Careers", link: "#" }, { label: "Contact", link: "#contact" },
];
const legalLinks = (settings.legal_links && settings.legal_links.length) ? settings.legal_links : [
  { label: "Privacy", link: "#" }, { label: "Terms", link: "#" },
];

const questions = typeof home.bs_problem_questions === "string" && home.bs_problem_questions.trim()
  ? home.bs_problem_questions.split(/\r?\n/).map((q) => q.trim()).filter(Boolean)
  : ["What should we say?", "Who should we speak to?", "How should we look?", "Where should we compete?", "Why should anyone choose us?"];
const brandServices = resolveSubservices(services, "01");
// Fallback card artwork (cycled) until per-subservice images are set in the CMS.
const subFallbackArt = ["/assets/subservices/research-insights.svg", "/assets/subservices/brand-strategy.svg", "/assets/subservices/brand-positioning.svg"];
const subColors = ["blue", "magenta", "teal", "gold"];
const pageTitle = home.bs_seo_title || "Brand & Strategy | Fineries Digital";
const pageDesc = home.bs_seo_description || "Brand research, strategy, positioning, architecture, identity and messaging that give people a reason to choose you.";
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={pageDesc} />
<link rel="icon" type="image/jpeg" href="/assets/fineries-favicon.jpg" />
<link rel="stylesheet" href="/css/v3.css?v=51" />
<link rel="stylesheet" href="/css/home.css?v=47" />
<link rel="stylesheet" href="/css/brand-strategy.css?v=6" />
<script src="https://unpkg.com/lucide@latest" is:inline defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" is:inline defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" is:inline defer></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js" is:inline defer></script>
</head>
<body>
<SiteNav navItems={navItems} settings={settings} active="/what-we-do" />
<main id="main">
  <section class="bshero on-blue">
    <div class="wrap bshero__inner">
      <div class="bshero__copy" data-rv>
        <span class="eyebrow">{home.bs_hero_eyebrow || "Brand & Strategy"}</span>
        <h1 class="bshero__title">{home.bs_hero_heading || "Give your brand something to stand for."}</h1>
        <div class="bshero__body body" set:html={home.bs_hero_body || "<p>Great brands aren't built by starting with a logo.</p><p>They're built by understanding the business, the market, the people you want to reach and the place you want to occupy in their minds.</p><p><strong>That's where we start.</strong></p>"}></div>
      </div>
      <button class="bshero__media" type="button" data-open-video aria-label="Play Brand & Strategy video" data-rv>
        <img class="bshero__poster" src={brandHeroPoster} alt="" aria-hidden="true" />
        <span class="bshero__shade" aria-hidden="true"></span>
        <span class="bshero__glow" aria-hidden="true"></span>
        <span class="bshero__play" aria-hidden="true"><i data-lucide="play"></i></span>
        <span class="bshero__watch">Watch video</span>
      </button>
    </div>
  </section>

  <div class="vmodal" data-video-modal aria-hidden="true">
    <div class="vmodal__frame">
      <button class="vmodal__close" type="button" data-close-video aria-label="Close video">&times;</button>
      <video controls playsinline preload="none" poster={brandHeroPoster} data-responsive-video data-desktop-src={brandHeroVideo} data-mobile-src={brandHeroVideoMobile}></video>
    </div>
  </div>

  <section class="sec bsproblem">
    <div class="wrap bsproblem__grid">
      <div data-rv>
        <span class="eyebrow">{home.bs_problem_eyebrow || "The Problem"}</span>
        <h2 class="h-lg bsproblem__title">{home.bs_problem_heading || "Clarity changes everything."}</h2>
        <div class="body bsproblem__body" set:html={home.bs_problem_body || "<p>When the strategy is clear, decisions become easier.</p><p>We help organisations find the answers.</p>"}></div>
      </div>
      <ol class="bsproblem__questions" data-rv-stagger>
        {questions.map((question, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{question}</li>)}
      </ol>
    </div>
  </section>

  <section class="sec bsservices">
    <div class="wrap">
      <div class="bsservices__head" data-rv>
        <span class="eyebrow">{home.bs_services_eyebrow || "What We Do"}</span>
        <h2 class="h-lg">{home.bs_services_heading || "Build from a clear point of view."}</h2>
      </div>
      <div class="svc3__grid" data-rv-stagger>
        {brandServices.map((service, index) => (
          <article class={`svc3 svc3--${subColors[index % subColors.length]}`}>
            <div class="svc3__img media"><img src={service.image || subFallbackArt[index % subFallbackArt.length]} alt="" /></div>
            <div class="svc3__panel">
              <span class="svc3__num">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="svc3__title" set:html={service.title}></h3>
              <p class="svc3__desc">{service.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta3 ctahome" id="contact">
    <div class="wrap cta3__inner on-blue">
      <div class="ctahome__grid">
        <div data-rv>
          <span class="eyebrow">{home.cta_eyebrow || "Let's Build"}</span>
          <h2 class="h-xl cta3__title" style="margin-top:18px">{home.cta_lead_in || "Ready to build"} <span class="hero3__rot cta3__rot" id="cta-rot" data-words={JSON.stringify(ctaWords)}>{ctaWords[0]}</span> {home.cta_lead_out || "people love?"}</h2>
          <p class="body" style="margin-top:18px;max-width:44ch">{home.cta_body || "Let's talk."}</p>
          <a class="cta3__action" href="/contact#form" style="margin-top:26px">
            <span class="circ"><i data-lucide="arrow-right"></i></span>
            <span>{home.cta_button_label || "Start a Conversation"}</span>
          </a>
        </div>
        <div class="ctahome__figure" aria-hidden="true">
          <img src={home.cta_image || heroImg} alt="" />
        </div>
      </div>
    </div>
  </section>
  <SiteFooter settings={settings} services={services} companyLinks={companyLinks} legalLinks={legalLinks} />
</main>
<script src="/js/v3.js?v=31" is:inline defer></script>
<script is:inline>
  (() => {
    const mobile = window.matchMedia("(max-width: 800px)");
    const video = document.querySelector("video[data-responsive-video]");
    const selectVideo = () => {
      if (!video) return;
      const nextSrc = mobile.matches ? video.dataset.mobileSrc : video.dataset.desktopSrc;
      if (!nextSrc || video.getAttribute("src") === nextSrc) return;
      video.pause();
      video.setAttribute("src", nextSrc);
      video.load();
    };
    selectVideo();
    mobile.addEventListener("change", selectVideo);
  })();
</script>
</body>
</html>
