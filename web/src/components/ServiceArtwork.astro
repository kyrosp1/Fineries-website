---
import yellowArtworkSource from "../assets/yellow.svg?raw";
import executiveArtworkSource from "../assets/executive.svg?raw";
const { num = "", title = "", fallback = "" } = Astro.props;
const key = String(num).padStart(2, "0");
const supported = ["01", "02", "03", "04", "05"].includes(key);
const yellowArtwork = yellowArtworkSource
  .replace(/<\?xml[\s\S]*?\?>\s*/i, "")
  .replace(/<!DOCTYPE[\s\S]*?>\s*/i, "")
  .replace(/\.fil/g, ".yellow-fil")
  .replace(/class="fil/g, 'class="yellow-fil')
  .replace("<svg ", '<svg class="svc-art__svg svc-art__svg--yellow" preserveAspectRatio="xMidYMid slice" ');
const executiveArtwork = executiveArtworkSource
  .replace(/<\?xml[\s\S]*?\?>\s*/i, "")
  .replace(/<!DOCTYPE[\s\S]*?>\s*/i, "")
  .replace(/\.fil/g, ".executive-fil")
  .replace(/class="fil/g, 'class="executive-fil')
  .replace("<svg ", '<svg class="svc-art__svg svc-art__svg--executive" preserveAspectRatio="xMidYMid slice" ');
---
<div class={`svc-art svc-art--${key}`} data-service-art aria-hidden="true">
  {fallback && <img class={`svc-art__fallback${supported ? " svc-art__fallback--hidden" : ""}`} src={fallback} alt="" />}
  {key === "01" && (
    <svg class="svc-art__svg" viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`${title} animated illustration`}>
      <defs><pattern id="stripes-01" width="25" height="25" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="11" height="25" fill="#3c4099"/></pattern></defs>
      <rect class="art-bg" width="600" height="400" rx="2" fill="#10bdb7"/>
      <g class="art-bars">
        <rect class="art-bar art-bar--1" x="116" y="210" width="96" height="142" fill="#3c4099"/>
        <rect class="art-bar art-bar--2" x="252" y="140" width="96" height="212" fill="#e00083"/>
        <rect class="art-bar art-bar--3" x="388" y="54" width="96" height="298" fill="url(#stripes-01)"/>
        <rect class="art-shine" x="388" y="54" width="96" height="298" fill="none" stroke="#fff" stroke-opacity=".08"/>
      </g>
    </svg>
  )}
  {key === "02" && (
    <svg class="svc-art__svg" viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`${title} animated illustration`}>
      <rect class="art-bg" width="600" height="400" rx="2" fill="#e00083"/>
      <g class="art-megaphone" fill="#3c4099"><path d="M128 145h144v110H128z"/><path d="M180 250h70v86h-70z"/></g>
      <g class="art-sound" fill="#3c4099">
        <path d="M282 146h10v108h-10z"/><path d="M305 136h10v128h-10z"/><path d="M328 126h10v148h-10z"/><path d="M351 116h10v168h-10z"/><path d="M374 106h10v188h-10z"/><path d="M397 96h10v208h-10z"/><path d="M420 86h10v228h-10z"/><path d="M443 76h10v248h-10z"/>
      </g>
    </svg>
  )}
  {key === "03" && (
    <svg class="svc-art__svg" viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`${title} animated illustration`}>
      <defs><pattern id="stripes-03" width="22" height="22" patternUnits="userSpaceOnUse"><rect width="10" height="22" fill="#e00083"/></pattern><clipPath id="tri-03"><path d="M314 74 508 200 314 326Z"/></clipPath></defs>
      <rect class="art-bg" width="600" height="400" rx="2" fill="#3c4099"/>
      <path class="art-play-left" d="M102 74 296 200 102 326Z" fill="#10bdb7"/>
      <g class="art-play-right" clip-path="url(#tri-03)"><rect class="art-play-stripes" x="314" y="68" width="210" height="264" fill="url(#stripes-03)"/></g>
      <circle class="art-play-pulse" cx="305" cy="200" r="12" fill="none" stroke="#fff" stroke-opacity=".4"/>
    </svg>
  )}
  {key === "04" && (
    <Fragment set:html={yellowArtwork} />
  )}
  {key === "05" && (
    <Fragment set:html={executiveArtwork} />
  )}
</div>
