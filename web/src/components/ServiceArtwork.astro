---
import digitalArtworkSource from "../assets/digital.svg?raw";
import brandArtworkSource from "../assets/brand.svg?raw";
import executiveArtworkSource from "../assets/executive.svg?raw";
import contentArtworkSource from "../assets/content.svg?raw";
const { num = "", title = "", fallback = "" } = Astro.props;
const key = String(num).padStart(2, "0");
const supported = ["01", "02", "03", "04", "05"].includes(key);
const brandArtwork = brandArtworkSource
  .replace(/<\?xml[\s\S]*?\?>\s*/i, "")
  .replace(/<!DOCTYPE[\s\S]*?>\s*/i, "")
  .replace(/\.fil/g, ".brand-fil")
  .replace(/class="fil/g, 'class="brand-fil')
  .replace("<svg ", '<svg class="svc-art__svg svc-art__svg--brand" preserveAspectRatio="xMidYMid slice" ');
const digitalArtwork = digitalArtworkSource
  .replace(/<\?xml[\s\S]*?\?>\s*/i, "")
  .replace(/<!DOCTYPE[\s\S]*?>\s*/i, "")
  .replace(/\.fil/g, ".digital-fil")
  .replace(/class="fil/g, 'class="digital-fil')
  .replace("<svg ", '<svg class="svc-art__svg svc-art__svg--digital" preserveAspectRatio="xMidYMid slice" ');
const executiveArtwork = executiveArtworkSource
  .replace(/<\?xml[\s\S]*?\?>\s*/i, "")
  .replace(/<!DOCTYPE[\s\S]*?>\s*/i, "")
  .replace(/\.fil/g, ".executive-fil")
  .replace(/class="fil/g, 'class="executive-fil')
  .replace('class="executive-fil1"', 'class="executive-fil1 executive-stripes"')
  .replace("<svg ", '<svg class="svc-art__svg svc-art__svg--executive" preserveAspectRatio="xMidYMid slice" ');
const contentArtwork = contentArtworkSource
  .replace(/<\?xml[\s\S]*?\?>\s*/i, "")
  .replace(/<!DOCTYPE[\s\S]*?>\s*/i, "")
  .replace(/\.fil/g, ".content-fil")
  .replace(/\.str/g, ".content-str")
  .replace(/class="fil/g, 'class="content-fil')
  .replace(/ str/g, " content-str")
  .replace("<svg ", '<svg class="svc-art__svg svc-art__svg--content" preserveAspectRatio="xMidYMid slice" ');
---
<div class={`svc-art svc-art--${key}`} data-service-art aria-hidden="true">
  {fallback && <img class={`svc-art__fallback${supported ? " svc-art__fallback--hidden" : ""}`} src={fallback} alt="" />}
  {key === "01" && (
    <Fragment set:html={brandArtwork} />
  )}
  {key === "02" && (
    <svg class="svc-art__svg" viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`${title} animated illustration`}>
      <rect class="art-bg" width="600" height="400" rx="2" fill="#e00083"/>
      <g class="art-megaphone" fill="#012676"><path d="M128 145h144v110H128z"/><path d="M180 250h70v86h-70z"/></g>
      <g class="art-sound" fill="#012676">
        <path d="M282 146h10v108h-10z"/><path d="M305 136h10v128h-10z"/><path d="M328 126h10v148h-10z"/><path d="M351 116h10v168h-10z"/><path d="M374 106h10v188h-10z"/><path d="M397 96h10v208h-10z"/><path d="M420 86h10v228h-10z"/><path d="M443 76h10v248h-10z"/>
      </g>
    </svg>
  )}
  {key === "03" && (
    <Fragment set:html={contentArtwork} />
  )}
  {key === "04" && (
    <Fragment set:html={digitalArtwork} />
  )}
  {key === "05" && (
    <Fragment set:html={executiveArtwork} />
  )}
</div>
