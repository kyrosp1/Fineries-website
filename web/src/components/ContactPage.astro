---
import SiteNav from "./SiteNav.astro";
import SiteFooter from "./SiteFooter.astro";
const { home = {}, settings = {}, services = [] } = Astro.props;
const email = settings.contact_email || "info@fineries.net";
const navItems = settings.nav_items?.length ? settings.nav_items : [{label:"Home",link:"/"},{label:"What We Do",link:"/what-we-do"},{label:"Work",link:"#"},{label:"About",link:"/about"},{label:"Insights",link:"#"},{label:"Contact",link:"/contact"}];
const companyLinks = settings.footer_company_links?.length ? settings.footer_company_links : [{label:"About",link:"/about"},{label:"Work",link:"#"},{label:"Insights",link:"#"},{label:"Careers",link:"#"},{label:"Contact",link:"/contact"}];
const legalLinks = settings.legal_links?.length ? settings.legal_links : [{label:"Privacy",link:"#"},{label:"Terms",link:"#"}];
const phone = settings.phone || settings.contact_phone || settings.phone_number || "";
---
<!DOCTYPE html><html lang="en"><head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{home.contact_seo_title || "Contact Fineries | Start a Conversation"}</title><meta name="description" content={home.contact_seo_description || "Tell Fineries about the brand, campaign, product or business challenge you want to solve."}/>
  <link rel="icon" type="image/jpeg" href="/assets/fineries-favicon.jpg"/><link rel="stylesheet" href="/css/v3.css?v=49"/><link rel="stylesheet" href="/css/home.css?v=47"/><link rel="stylesheet" href="/css/about-contact.css?v=3"/>
  <script src="https://unpkg.com/lucide@latest" is:inline defer></script><script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" is:inline defer></script><script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" is:inline defer></script><script src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js" is:inline defer></script>
</head><body><SiteNav navItems={navItems} settings={settings} active="/contact"/>
<main id="main">
  <section class="cohero"><div class="wrap cohero__grid on-blue"><div data-rv><span class="eyebrow">{home.contact_hero_eyebrow || "Let's Talk"}</span><h1>{home.contact_hero_heading || "Have something worth building?"}</h1></div><div class="cohero__body" set:html={home.contact_hero_body || "<p>Maybe it's a brand that needs rethinking. A campaign that needs launching. A business that needs growing. A product that needs building.</p><p>Or a problem you're not quite sure how to solve yet.</p><p><strong>Tell us about it.</strong></p>"} data-rv></div></div></section>
  <section class="sec contact"><div class="wrap contact__grid">
    <div class="contact__intro" data-rv>
      <span class="cin__icon"><i data-lucide="arrow-right"></i></span>
      <h2 class="cin__title">{home.contact_form_eyebrow || "Get in Touch"}</h2>
      <svg class="cin__wave" width="118" height="14" viewBox="0 0 118 14" fill="none" aria-hidden="true"><path d="M2 8c8-8 16-8 22 0s16 8 22 0 16-8 22 0 16 8 22 0 16-8 22 0" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
      <p class="cin__lead">{home.contact_intro_body || "Tell us about the brand, campaign, product or business challenge you want to solve — and we'll get back to you."}</p>
      <div class="cin__block"><span>Office Address</span><p>{settings.address || "AHCN Towers, 38 CIPM Road, Alausa, Lagos, Nigeria"}</p></div>
      <div class="cin__block"><span>Email</span><a href={`mailto:${email}`}>{email}</a></div>
      {phone && <div class="cin__block"><span>Phone Number</span><p>{phone}</p></div>}
      <div class="cin__socials">
        {settings.social_linkedin && <a href={settings.social_linkedin} aria-label="LinkedIn"><i data-lucide="linkedin"></i></a>}
        {settings.social_instagram && <a href={settings.social_instagram} aria-label="Instagram"><i data-lucide="instagram"></i></a>}
        {settings.social_x && <a href={settings.social_x} aria-label="X"><i data-lucide="twitter"></i></a>}
      </div>
    </div>
    <form class="contact__form cf" data-contact-form data-email={email} data-rv>
      <div class="cf__group">
        <span class="cf__label">Name <em>(Required)</em></span>
        <div class="cf__two">
          <label class="cf__field"><small>First</small><input required name="first" autocomplete="given-name"/></label>
          <label class="cf__field"><small>Last</small><input required name="last" autocomplete="family-name"/></label>
        </div>
      </div>
      <div class="cf__group">
        <span class="cf__label">Email <em>(Required)</em></span>
        <div class="cf__two">
          <label class="cf__field"><small>Enter Email</small><input required type="email" name="email" autocomplete="email"/></label>
          <label class="cf__field"><small>Confirm Email</small><input required type="email" name="email_confirm"/></label>
        </div>
      </div>
      <div class="cf__group">
        <span class="cf__label">Phone <em>(Required)</em></span>
        <label class="cf__field"><input required type="tel" name="phone" autocomplete="tel"/></label>
      </div>
      <div class="cf__group">
        <span class="cf__label">Message <em>(Required)</em></span>
        <label class="cf__field"><small>Please enter your message here.</small><textarea required name="challenge" maxlength="600"></textarea></label>
        <div class="cf__count"><span data-char-count>0</span> of 600 max characters</div>
      </div>
      <button class="cf__submit" type="submit">{home.contact_submit_label || "Submit"}</button>
      <p class="cf__note">Submitting opens your email app with the details ready to send.</p>
    </form>
  </div></section>
  <SiteFooter settings={settings} services={services} companyLinks={companyLinks} legalLinks={legalLinks}/>
</main><script src="/js/v3.js?v=29" is:inline defer></script>
<script is:inline>
  const cform=document.querySelector("[data-contact-form]");
  cform?.addEventListener("submit", (event) => {
    event.preventDefault(); const form=event.currentTarget; const data=new FormData(form);
    if((data.get("email")||"") !== (data.get("email_confirm")||"")){ alert("The email addresses don't match. Please check and try again."); return; }
    const name=`${data.get("first")||""} ${data.get("last")||""}`.trim();
    const subject=`Enquiry from ${name || "Fineries website"}`;
    const body=[`Name: ${name}`,`Email: ${data.get("email")||""}`,`Phone: ${data.get("phone")||""}`,"",String(data.get("challenge")||"")].join("\n");
    window.location.href=`mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
  const cta=cform?.querySelector('textarea[name="challenge"]'); const ccount=cform?.querySelector('[data-char-count]');
  if(cta && ccount){ cta.addEventListener("input", () => { ccount.textContent=String(cta.value.length); }); }
</script></body></html>
