---
import SiteNav from "./SiteNav.astro";
import SiteFooter from "./SiteFooter.astro";
const { home = {}, settings = {}, services = [] } = Astro.props;
const email = settings.contact_email || "info@fineries.net";
const navItems = settings.nav_items?.length ? settings.nav_items : [{label:"Home",link:"/"},{label:"What We Do",link:"/what-we-do"},{label:"Work",link:"#"},{label:"About",link:"/about"},{label:"Insights",link:"#"},{label:"Contact",link:"/contact"}];
const companyLinks = settings.footer_company_links?.length ? settings.footer_company_links : [{label:"About",link:"/about"},{label:"Work",link:"#"},{label:"Insights",link:"#"},{label:"Careers",link:"#"},{label:"Contact",link:"/contact"}];
const legalLinks = settings.legal_links?.length ? settings.legal_links : [{label:"Privacy",link:"#"},{label:"Terms",link:"#"}];
const phone = settings.phone || settings.contact_phone || settings.phone_number || "";
const serviceChoices = ["Brand & Strategy","Marketing & Growth","Content & Production","Digital Products & Technology","Executive Authority","Something else / Not sure yet"];
---
<!DOCTYPE html><html lang="en"><head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{home.contact_seo_title || "Contact Fineries | Start a Conversation"}</title><meta name="description" content={home.contact_seo_description || "Tell Fineries about the brand, campaign, product or business challenge you want to solve."}/>
  <link rel="icon" type="image/jpeg" href="/assets/fineries-favicon.jpg"/><link rel="stylesheet" href="/css/v3.css?v=53"/><link rel="stylesheet" href="/css/home.css?v=47"/><link rel="stylesheet" href="/css/about-contact.css?v=11"/>
  <script src="https://unpkg.com/lucide@latest" is:inline defer></script><script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" is:inline defer></script><script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" is:inline defer></script><script src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js" is:inline defer></script>
</head><body><SiteNav navItems={navItems} settings={settings} services={services} active="/contact"/>
<main id="main">
  <section class="cohero">
    <div class="cophone" aria-hidden="true"><img src={home.contact_phone_image || "/assets/phone-handset.png"} alt="" onerror="this.closest('.cophone').style.display='none'"/></div>
    <div class="wrap cohero__grid on-blue"><div data-rv><span class="eyebrow">{home.contact_hero_eyebrow || "Let's Talk"}</span><h1>{home.contact_hero_heading || "Have something worth building?"}</h1></div><div class="cohero__body" set:html={home.contact_hero_body || "<p>Maybe it's a brand that needs rethinking. A campaign that needs launching. A business that needs growing. A product that needs building.</p><p>Or a problem you're not quite sure how to solve yet.</p><p><strong>Tell us about it.</strong></p>"} data-rv></div></div></section>
  <section class="sec contact"><div class="wrap contact__grid">
    <div class="contact__intro" data-rv>
      <span class="cin__icon"><i data-lucide="arrow-right"></i></span>
      <h2 class="cin__title">{home.contact_form_eyebrow || "Get in Touch"}</h2>
      <svg class="cin__wave" width="118" height="14" viewBox="0 0 118 14" fill="none" aria-hidden="true"><path d="M2 8c8-8 16-8 22 0s16 8 22 0 16-8 22 0 16 8 22 0 16-8 22 0" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
      <p class="cin__lead">{home.contact_intro_body || "Tell us about the brand, campaign, product or business challenge you want to solve — and we'll get back to you."}</p>
      <div class="cin__block"><span>Office Address</span><p>{settings.address || "AHCN Towers, 38 CIPM Road, Alausa, Lagos, Nigeria"}</p></div>
      <div class="cin__block"><span>Email</span><a href={`mailto:${email}`}>{email}</a></div>
      {phone && <div class="cin__block"><span>Phone Number</span><p>{phone}</p></div>}
      <div class="cin__socials">
        {settings.social_linkedin && <a href={settings.social_linkedin} aria-label="LinkedIn"><i data-lucide="linkedin"></i></a>}
        {settings.social_instagram && <a href={settings.social_instagram} aria-label="Instagram"><i data-lucide="instagram"></i></a>}
        {settings.social_x && <a href={settings.social_x} aria-label="X"><i data-lucide="twitter"></i></a>}
      </div>
    </div>
    <form class="contact__form cf" id="form" data-contact-form data-email={email} data-rv>
      <div class="cf__two">
        <div class="cf__group"><span class="cf__label">What should we call you? <em>(Required)</em></span><label class="cf__field"><input required name="name" autocomplete="name" placeholder="Your name"/></label></div>
        <div class="cf__group"><span class="cf__label">Where do you work? <em>(Required)</em></span><label class="cf__field"><input required name="company" autocomplete="organization" placeholder="Company or organisation"/></label></div>
      </div>
      <div class="cf__group"><span class="cf__label">What's your email? <em>(Required)</em></span><label class="cf__field"><input required type="email" name="email" autocomplete="email" placeholder="you@company.com"/></label></div>
      <div class="cf__group">
        <span class="cf__label">What would you like to work on? <em>(Required — select all that apply)</em></span>
        <div class="contact__choices">{serviceChoices.map((choice)=><label><input type="checkbox" name="service" value={choice}/><span>{choice}</span></label>)}</div>
      </div>
      <div class="cf__group"><span class="cf__label">Tell us a little about the challenge. <em>(Required)</em></span><label class="cf__field"><textarea required name="challenge" rows="5" placeholder="What are you trying to change, create or achieve?"></textarea></label></div>
      <div class="cf__two">
        <div class="cf__group"><span class="cf__label">What kind of budget are you working with? <em>(Required)</em></span><label class="cf__field"><select required name="budget"><option value="">Select a range</option><option>Under ₦5m</option><option>₦5m – ₦15m</option><option>₦15m – ₦50m</option><option>₦50m+</option><option>Not sure yet</option></select></label></div>
        <div class="cf__group"><span class="cf__label">When would you like to start? <em>(Required)</em></span><label class="cf__field"><select required name="timeline"><option value="">Select timing</option><option>As soon as possible</option><option>Within 1–3 months</option><option>Within 3–6 months</option><option>Later this year</option><option>Not sure yet</option></select></label></div>
      </div>
      <input type="text" name="company_url" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
      <button class="cf__submit" type="submit">{home.contact_submit_label || "Send Enquiry"}</button>
      <p class="cf__note">We usually reply within one business day.</p>
    </form>
  </div></section>
  <SiteFooter settings={settings} services={services} companyLinks={companyLinks} legalLinks={legalLinks}/>
</main><script src="/js/v3.js?v=29" is:inline defer></script>
<script is:inline>
  const cform = document.querySelector("[data-contact-form]");
  cform?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const data = new FormData(form);
    const payload = {
      name: data.get("name") || "",
      company: data.get("company") || "",
      email: data.get("email") || "",
      service: data.getAll("service").filter(Boolean),
      budget: data.get("budget") || "",
      timeline: data.get("timeline") || "",
      challenge: data.get("challenge") || "",
      company_url: data.get("company_url") || "",
    };
    const btn = form.querySelector(".cf__submit");
    const note = form.querySelector(".cf__note");
    if (!payload.service.length) {
      if (note) { note.textContent = "Please select at least one option for what you'd like to work on."; note.style.color = "var(--v3-magenta)"; }
      form.querySelector('input[name="service"]')?.focus();
      return;
    }
    const original = btn.textContent;
    btn.disabled = true; btn.textContent = "Sending…";
    if (note) { note.style.color = ""; note.textContent = "We usually reply within one business day."; }
    try {
      const r = await fetch("/api/enquiry", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const j = await r.json().catch(() => ({}));
      if (r.ok && j.ok) {
        form.innerHTML = '<div class="cf__success"><h3 class="cf__label" style="font-size:22px">Thank you — your message has been sent.</h3><p style="margin-top:8px;color:var(--v3-text-2)">We’ve received your enquiry and will get back to you shortly.</p></div>';
      } else {
        btn.disabled = false; btn.textContent = original;
        if (note) { note.textContent = (j && j.message) || "Something went wrong. Please try again, or email info@fineries.net."; note.style.color = "var(--v3-magenta)"; }
      }
    } catch (e) {
      btn.disabled = false; btn.textContent = original;
      if (note) { note.textContent = "Network error. Please try again, or email info@fineries.net."; note.style.color = "var(--v3-magenta)"; }
    }
  });
</script></body></html>
