---
// Shared site header + mobile menu + "What We Do" mega-menu. Nav items are CMS-driven
// (settings.nav_items); the mega-menu is built from the services (CMS service CPT).
import ServiceArtwork from "./ServiceArtwork.astro";
const { navItems = [], settings = {}, services = [], active = "" } = Astro.props;
const canonicalLinks = {
  "Home": "/",
  "What We Do": "/what-we-do",
  "About": "/about",
  "Contact": "/contact",
};
const resolvedNavItems = navItems.map((item) => ({
  ...item,
  link: canonicalLinks[item.label] || item.link || "#",
}));
const isActive = (n) => (active && (n.link === active || n.label === active)) || (!active && n.link === "/");

const fallbackServices = [
  { num: "01", title: "Brand & Strategy", link: "/brand-and-strategy", description: "Find the right position. Build a brand with something to say." },
  { num: "02", title: "Marketing & Growth", link: "/marketing-and-growth", description: "Reach the right people. Turn attention into action." },
  { num: "03", title: "Content & Production", link: "/content-and-production", description: "Create work worth noticing, remembering and sharing." },
  { num: "04", title: "Digital Products & Technology", link: "/digital-and-tech", description: "Build digital experiences, products and systems that make the business better." },
  { num: "05", title: "Executive Authority", link: "/executive-authority", description: "Help leaders become known for what they know and what they stand for." },
];
const menuServices = (services && services.length)
  ? services.filter((s) => s.num && s.title).sort((a, b) => String(a.num).localeCompare(String(b.num)))
      .map((s) => ({ num: s.num, title: s.title, link: s.link || "#", description: s.description || "" }))
  : fallbackServices;

const cfBeaconToken = settings.cf_analytics_token || import.meta.env.PUBLIC_CF_BEACON_TOKEN || "";
---
{cfBeaconToken && (
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}></script>
)}
<header class="nav3">
  <div class="nav3__inner">
    <a class="nav3__logo" href="/" aria-label="Fineries Digital home">
      <img class="logo-white" src="/assets/fineries-logo-white-3x.png" alt="Fineries Digital" />
      <img class="logo-blue" src="/assets/fineries-logo-blue-3x.png" alt="Fineries Digital" />
    </a>
    <nav class="nav3__links" aria-label="Primary">
      {resolvedNavItems.map((n) => (
        n.label === "What We Do" ? (
          <span class="nav3__item nav3__item--mega" data-mega>
            <a class={`nav3__link${isActive(n) ? " nav3__link--active" : ""}`} href={n.link || "#"} data-mega-link aria-haspopup="true" aria-expanded="false">{n.label}</a>
          </span>
        ) : (
          <a class={`nav3__link${isActive(n) ? " nav3__link--active" : ""}`} href={n.link || "#"}>{n.label}</a>
        )
      ))}
    </nav>
    <button class="nav3__burger" aria-label="Open menu" aria-expanded="false"><i data-lucide="menu"></i></button>
  </div>
</header>

<!-- What We Do mega-menu (kept OUTSIDE <header> so the nav's transform/backdrop-filter
     never becomes the containing block; positioned under the bar by JS). -->
<div class="megamenu" data-mega-panel aria-label="What We Do">
  <div class="wrap megamenu__inner">
    <div class="megamenu__head">
      <span class="eyebrow">What We Do</span>
      <a class="megamenu__all" href="/what-we-do">Explore all capabilities <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
    <div class="megamenu__grid">
      {menuServices.map((s) => (
        <a class="megacard" href={s.link}>
          <span class="megacard__art"><ServiceArtwork num={s.num} title={s.title} /></span>
          <span class="megacard__num">{s.num}</span>
          <span class="megacard__title" set:html={s.title}></span>
          <span class="megacard__desc">{s.description}</span>
        </a>
      ))}
    </div>
  </div>
</div>

<!-- Mobile menu kept OUTSIDE <header> so the nav's transform/backdrop-filter
     (is-hidden / is-solid) never becomes the containing block for this fixed overlay. -->
<div class="mnav" data-mnav aria-hidden="true">
    <div class="mnav__backdrop" data-mnav-close aria-hidden="true"></div>
    <div class="mnav__panel">
    <div class="mnav__top">
      <a class="mnav__logo" href="/" aria-label="Fineries Digital home">
        <img src="/assets/fineries-logo-white-3x.png" alt="Fineries Digital" />
      </a>
      <button class="mnav__close" type="button" data-mnav-close aria-label="Close menu">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <nav class="mnav__links" aria-label="Mobile">
      {resolvedNavItems.map((n, i) => (
        n.label === "What We Do" ? (
          <div class="mnav__group" data-mgroup>
            <button class="mnav__grouptoggle" type="button" aria-expanded="false" data-mgroup-toggle>
              <span>{n.label}</span>
              <span class="mnav__row-right">
                <svg class="mnav__chev" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                <em>{String(i + 1).padStart(2, "0")}</em>
              </span>
            </button>
            <div class="mnav__sub" data-mgroup-sub>{menuServices.map((s) => <a class="mnav__subitem" href={s.link} set:html={s.title}></a>)}</div>
          </div>
        ) : (
          <a href={n.link || "#"}><span>{n.label}</span><em>{String(i + 1).padStart(2, "0")}</em></a>
        )
      ))}
    </nav>
    <div class="mnav__foot">
      <span class="mnav__rule"></span>
      <img class="mnav__lockup" src="/assets/statement-white.svg" alt="We build brands people love" />
      <div class="mnav__social">
        <a href={settings.social_linkedin || "#"} aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.76-2.05C20.4 8.65 21 11 21 14.1V21h-4v-6.1c0-1.45-.03-3.32-2.02-3.32-2.02 0-2.33 1.58-2.33 3.21V21H9z"/></svg></a>
        <a href={settings.social_instagram || "#"} aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></a>
        <a href={settings.social_x || "#"} aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor" width="17" height="17" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.22-6.82-5.97 6.82H1.66l7.73-8.84L1.25 2.25h6.82l4.71 6.23zm-1.16 17.52h1.83L7.01 4.13H5.05z"/></svg></a>
        <a href={settings.social_youtube || "#"} aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 00.5 6.2 31.4 31.4 0 000 12a31.4 31.4 0 00.5 5.8 3 3 0 002.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 002.1-2.1A31.4 31.4 0 0024 12a31.4 31.4 0 00-.5-5.8zM9.6 15.6V8.4l6.2 3.6z"/></svg></a>
      </div>
    </div>
    </div>
  </div>

<script is:inline>
  (() => {
    const desktop = window.matchMedia("(min-width: 861px)");
    const header = document.querySelector(".nav3");
    const item = document.querySelector("[data-mega]");
    const panel = document.querySelector("[data-mega-panel]");
    if (!header || !item || !panel) return;
    const link = item.querySelector("[data-mega-link]");
    let hideTimer = null;
    const place = () => { panel.style.top = Math.round(header.getBoundingClientRect().bottom) + "px"; };
    const open = () => {
      if (!desktop.matches) return;
      clearTimeout(hideTimer); place();
      panel.classList.add("is-open");
      if (link) link.setAttribute("aria-expanded", "true");
    };
    const close = () => {
      panel.classList.remove("is-open");
      if (link) link.setAttribute("aria-expanded", "false");
    };
    const scheduleClose = () => { hideTimer = setTimeout(close, 160); };
    item.addEventListener("mouseenter", open);
    item.addEventListener("mouseleave", scheduleClose);
    panel.addEventListener("mouseenter", () => clearTimeout(hideTimer));
    panel.addEventListener("mouseleave", scheduleClose);
    item.addEventListener("focusin", open);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
    window.addEventListener("scroll", () => { if (panel.classList.contains("is-open")) place(); }, { passive: true });
    desktop.addEventListener("change", close);
  })();
  // Mobile: collapse services under "What We Do" — tap to expand.
  (() => {
    document.querySelectorAll("[data-mgroup-toggle]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const grp = btn.closest("[data-mgroup]");
        if (!grp) return;
        const isOpen = grp.classList.toggle("is-open");
        btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
      });
    });
  })();
</script>
