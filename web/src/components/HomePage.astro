---
import SiteNav from "./SiteNav.astro";
import SiteFooter from "./SiteFooter.astro";
const { home, settings, services = [], work = [], preview = false } = Astro.props;

const heroWords = home.hero_words && home.hero_words.length ? home.hero_words : ["brands", "products", "content"];
const ctaWords = home.cta_words && home.cta_words.length ? home.cta_words : ["a brand", "a product", "content"];
const navItems = (settings.nav_items && settings.nav_items.length) ? settings.nav_items : [
  { label: "Home", link: "/" },
  { label: "What We Do", link: "/what-we-do" },
  { label: "Work", link: "#" },
  { label: "About", link: "#" },
  { label: "Insights", link: "#" },
  { label: "Contact", link: "#" },
];
const companyLinks = (settings.footer_company_links && settings.footer_company_links.length) ? settings.footer_company_links : [
  { label: "About", link: "#" }, { label: "Work", link: "#" }, { label: "Insights", link: "#" }, { label: "Careers", link: "#" }, { label: "Contact", link: "#" },
];
const legalLinks = (settings.legal_links && settings.legal_links.length) ? settings.legal_links : [
  { label: "Privacy", link: "#" }, { label: "Terms", link: "#" },
];
const logos = (home.logos && home.logos.length) ? home.logos : [
  { name: "Meristem" }, { name: "CrusaderSterling" },
  { name: "Farmfresh / reFresh" }, { name: "IBOM Air" },
];
// Pad to enough items for a seamless loop on wide screens, then the template
// renders this set twice and animates by -50%.
let logoLoop = [];
if (logos.length) { while (logoLoop.length < 12) logoLoop = logoLoop.concat(logos); }
const heroImg = home.hero_image || "";
const heroVideo = home.hero_video || "";
const workImg = (w) => w.image || "";
const svcImg = (s) => s.image || "";
const truth1 = home.truth_image_1 || "";
const bvItems = Array.isArray(home.bv_items) ? home.bv_items : [];
const rings = Array.isArray(home.philosophy_rings) ? home.philosophy_rings : [];
const steps = Array.isArray(home.process_steps) ? home.process_steps : [];
const ringColor = ["blue", "magenta", "teal"];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{settings.seo_title || "Fineries Digital | We Build Brands, Products, Content People Love | Lagos, Nigeria"}</title>
<meta name="description" content={settings.seo_description || "Fineries Digital brings strategy, creativity and technology together to help ambitious organisations grow, connect and create what comes next."} />
<link rel="icon" type="image/jpeg" href="/assets/fineries-favicon.jpg" />
<link rel="stylesheet" href="/css/v3.css?v=47" />
<link rel="stylesheet" href="/css/home.css?v=51" />
<script src="https://unpkg.com/lucide@latest" is:inline defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" is:inline defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" is:inline defer></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js" is:inline defer></script>
</head>
<body>

{preview && (
  <div class="preview-badge">Preview mode — showing unpublished content</div>
)}

<SiteNav navItems={navItems} settings={settings} active="/" />

<main id="main">

<!-- HERO (unchanged) -->
<section class="hero3" style={`--v3-hero-bg:${home.hero_bg_color || "#3C4099"}`}>
  <img class="hero3__couple" src={heroImg} alt="A couple in Nigerian formal wear sharing a dance" />
  <div class="wrap hero3__inner">
    <h1 class="hero3__title">{home.hero_lead_in || "We build"} <span class="hero3__rot" id="hero-rot" data-words={JSON.stringify(heroWords)}>{heroWords[0]}</span> {home.hero_lead_out || "people love"}</h1>
    <button class="hero3__watch" type="button" data-open-video>
      <span>{home.hero_watch_label || "Watch our story"}</span>
      <span class="play"><i data-lucide="play"></i></span>
    </button>
  </div>
</section>

<div class="vmodal" data-video-modal aria-hidden="true">
  <div class="vmodal__frame">
    <button class="vmodal__close" type="button" data-close-video aria-label="Close video">&times;</button>
    <video controls playsinline preload="none">
      {heroVideo && <source src={heroVideo} type="video/mp4" />}
    </video>
  </div>
</div>

<!-- WHAT WE DO — service cards -->
<section class="sec wwd-sec" style="background:#f5f5f5">
  <div class="wrap">
    <div class="wwd2__head" data-rv>
      <div>
        <span class="eyebrow">{home.wwd_eyebrow || "What We Do"}</span>
        <h2 class="h-lg wwd2__title">{home.wwd_heading} <span class="teal">{home.wwd_heading_accent}</span></h2>
      </div>
      <div class="wwd2__aside">
        <p class="body">{home.wwd_body}</p>
        <a class="btn3 btn3--teal" href="#">{home.wwd_cta_label || "Explore our capabilities"} <i data-lucide="arrow-right"></i></a>
      </div>
    </div>
    <div class="svc3__grid" data-rv-stagger>
      {services.map((s) => (
        <a class={`svc3 svc3--${s.color || "blue"}`} href={s.link || "#"}>
          <div class="svc3__img media"><img src={svcImg(s)} alt={s.title} /></div>
          <div class="svc3__panel">
            <span class="svc3__num">{s.num}</span>
            <h3 class="svc3__title" set:html={s.title}></h3>
            <p class="svc3__desc">{s.description}</p>
            <span class="svc3__arrow"><i data-lucide="arrow-right"></i></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- THE TRUTH -->
<section class="truth">
  <div class="truth__media" data-rv>
    <div class="media"><img src={truth1} alt="" /></div>
  </div>
  <div class="truth__text" data-rv>
    <span class="eyebrow">{home.truth_eyebrow || "The Truth"}</span>
    <h2 class="h-lg">{home.truth_heading}</h2>
    <div class="truth__body body" set:html={home.truth_body}></div>
  </div>
</section>

<!-- OUR PROCESS -->
<section class="process on-blue">
  <div class="wrap process__grid">
    <div class="process__intro" data-rv>
      <span class="eyebrow">{home.process_eyebrow || "Our Process"}</span>
      <h2 class="h-lg" style="color:#fff;margin:16px 0 20px">{home.process_heading}</h2>
      <p class="body">{home.process_body}</p>
      <a class="btn3" href="#" style="margin-top:26px">{home.process_cta_label || "See how we work"} <i data-lucide="arrow-right"></i></a>
    </div>
    <div class="process__timeline" data-process-timeline>
      <div class="process__rail" aria-hidden="true"><span data-process-progress></span></div>
      {steps.map((st) => (
        <article class="pstep" data-process-step>
          <div class="pstep__node">
            <span class="pstep__core" aria-hidden="true"></span>
            <span class="pstep__num">{st.num}</span>
            <span class="pstep__icon"><i data-lucide={st.icon || "circle"}></i></span>
          </div>
          <div class="pstep__copy">
            <h4 class="pstep__title">{st.title}</h4>
            <p class="pstep__desc">{st.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- CLIENT LOGOS (sliding marquee) -->
<section class="logos sec" style="background:var(--v3-mist)">
  <div class="wrap logos__head" data-rv>
    <span class="eyebrow">{home.logos_eyebrow || "Selected Clients"}</span>
    <h2 class="h-lg" style="margin-top:12px">{home.logos_heading || "Real brands. Real impact."}</h2>
  </div>
  <div class="logos__viewport">
    <div class="logos__track">
      {[...logoLoop, ...logoLoop].map((l) => (
        <div class="logos__item">
          {l.image
            ? <img src={l.image} alt={l.name || "Client logo"} />
            : <span class="logos__word">{l.name}</span>}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="cta3 ctahome">
  <div class="wrap cta3__inner on-blue">
    <div class="ctahome__grid">
      <div data-rv>
        <span class="eyebrow">{home.cta_eyebrow || "Let's Build"}</span>
        <h2 class="h-xl cta3__title" style="margin-top:18px">{home.cta_lead_in || "Ready to build"} <span class="hero3__rot cta3__rot" id="cta-rot" data-words={JSON.stringify(ctaWords)}>{ctaWords[0]}</span> {home.cta_lead_out || "people love?"}</h2>
        <p class="body" style="margin-top:18px;max-width:44ch">{home.cta_body || "Let's talk."}</p>
        <a class="cta3__action" href="#" style="margin-top:26px">
          <span class="circ"><i data-lucide="arrow-right"></i></span>
          <span>{home.cta_button_label || "Start a Conversation"}</span>
        </a>
      </div>
      <div class="ctahome__figure" aria-hidden="true">
        <img src={home.cta_image || heroImg} alt="" />
      </div>
    </div>
  </div>
</section>

<SiteFooter settings={settings} services={services} companyLinks={companyLinks} legalLinks={legalLinks} />

</main>

<script src="/js/v3.js?v=28" is:inline defer></script>
</body>
</html>
