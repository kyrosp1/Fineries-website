---
const { home, settings, services = [], work = [], preview = false } = Astro.props;

const heroWords = home.hero_words && home.hero_words.length ? home.hero_words : ["brands", "products", "content"];
const ctaWords = home.cta_words && home.cta_words.length ? home.cta_words : ["a brand", "a product", "content"];
const navItems = (settings.nav_items && settings.nav_items.length) ? settings.nav_items : [
  { label: "Home", link: "/" },
  { label: "What We Do", link: "#" },
  { label: "Work", link: "#" },
  { label: "About", link: "#" },
  { label: "Insights", link: "#" },
  { label: "Contact", link: "#" },
];
const companyLinks = (settings.footer_company_links && settings.footer_company_links.length) ? settings.footer_company_links : [
  { label: "About", link: "#" }, { label: "Work", link: "#" }, { label: "Insights", link: "#" }, { label: "Careers", link: "#" }, { label: "Contact", link: "#" },
];
const legalLinks = (settings.legal_links && settings.legal_links.length) ? settings.legal_links : [
  { label: "Privacy", link: "#" }, { label: "Terms", link: "#" },
];
const logos = (home.logos && home.logos.length) ? home.logos : [
  { name: "Meristem" }, { name: "CrusaderSterling" },
  { name: "Farmfresh / reFresh" }, { name: "IBOM Air" },
];
// Pad to enough items for a seamless loop on wide screens, then the template
// renders this set twice and animates by -50%.
let logoLoop = [];
if (logos.length) { while (logoLoop.length < 12) logoLoop = logoLoop.concat(logos); }
const heroImg = home.hero_image || "";
const heroVideo = home.hero_video || "";
const workImg = (w) => w.image || "";
const svcImg = (s) => s.image || "";
const truth1 = home.truth_image_1 || "";
const bvItems = Array.isArray(home.bv_items) ? home.bv_items : [];
const rings = Array.isArray(home.philosophy_rings) ? home.philosophy_rings : [];
const steps = Array.isArray(home.process_steps) ? home.process_steps : [];
const ringColor = ["blue", "magenta", "teal"];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Fineries Digital | We Build Brands, Products, Content People Love | Lagos, Nigeria</title>
<meta name="description" content="Fineries Digital brings strategy, creativity and technology together to help ambitious organisations grow, connect and create what comes next." />
<link rel="icon" type="image/jpeg" href="/assets/fineries-favicon.jpg" />
<link rel="stylesheet" href="/css/v3.css?v=47" />
<link rel="stylesheet" href="/css/home.css?v=47" />
<script src="https://unpkg.com/lucide@latest" is:inline defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" is:inline defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" is:inline defer></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js" is:inline defer></script>
</head>
<body>

{preview && (
  <div class="preview-badge">Preview mode — showing unpublished content</div>
)}

<!-- NAV -->
<header class="nav3">
  <div class="nav3__inner">
    <a class="nav3__logo" href="/" aria-label="Fineries Digital home">
      <img class="logo-white" src="/assets/fineries-logo-white-3x.png" alt="Fineries Digital" />
      <img class="logo-blue" src="/assets/fineries-logo-blue-3x.png" alt="Fineries Digital" />
    </a>
    <nav class="nav3__links" aria-label="Primary">
      {navItems.map((n) => (
        <a class={`nav3__link${(n.link === "/" ) ? " nav3__link--active" : ""}`} href={n.link || "#"}>{n.label}</a>
      ))}
    </nav>
    <button class="nav3__burger" aria-label="Open menu" aria-expanded="false"><i data-lucide="menu"></i></button>
  </div>
  <div class="mnav" data-mnav aria-hidden="true">
    <div class="mnav__backdrop" data-mnav-close aria-hidden="true"></div>
    <div class="mnav__panel">
    <div class="mnav__top">
      <a class="mnav__logo" href="/" aria-label="Fineries Digital home">
        <img src="/assets/fineries-logo-white-3x.png" alt="Fineries Digital" />
      </a>
      <button class="mnav__close" type="button" data-mnav-close aria-label="Close menu">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <nav class="mnav__links" aria-label="Mobile">
      {navItems.map((n, i) => (
        <a href={n.link || "#"}><span>{n.label}</span><em>{String(i + 1).padStart(2, "0")}</em></a>
      ))}
    </nav>
    <div class="mnav__foot">
      <span class="mnav__rule"></span>
      <img class="mnav__lockup" src="/assets/statement-white.svg" alt="We build brands people love" />
      <div class="mnav__social">
        <a href={settings.social_linkedin || "#"} aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.76-2.05C20.4 8.65 21 11 21 14.1V21h-4v-6.1c0-1.45-.03-3.32-2.02-3.32-2.02 0-2.33 1.58-2.33 3.21V21H9z"/></svg></a>
        <a href={settings.social_instagram || "#"} aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></a>
        <a href={settings.social_x || "#"} aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor" width="17" height="17" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.22-6.82-5.97 6.82H1.66l7.73-8.84L1.25 2.25h6.82l4.71 6.23zm-1.16 17.52h1.83L7.01 4.13H5.05z"/></svg></a>
        <a href={settings.social_youtube || "#"} aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 00.5 6.2 31.4 31.4 0 000 12a31.4 31.4 0 00.5 5.8 3 3 0 002.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 002.1-2.1A31.4 31.4 0 0024 12a31.4 31.4 0 00-.5-5.8zM9.6 15.6V8.4l6.2 3.6z"/></svg></a>
      </div>
    </div>
    </div>
  </div>
</header>

<main id="main">

<!-- HERO (unchanged) -->
<section class="hero3" style={`--v3-hero-bg:${home.hero_bg_color || "#3C4099"}`}>
  <img class="hero3__couple" src={heroImg} alt="A couple in Nigerian formal wear sharing a dance" />
  <div class="wrap hero3__inner">
    <h1 class="hero3__title">{home.hero_lead_in || "We build"} <span class="hero3__rot" id="hero-rot" data-words={JSON.stringify(heroWords)}>{heroWords[0]}</span> {home.hero_lead_out || "people love"}</h1>
    <button class="hero3__watch" type="button" data-open-video>
      <span>{home.hero_watch_label || "Watch our story"}</span>
      <span class="play"><i data-lucide="play"></i></span>
    </button>
  </div>
</section>

<div class="vmodal" data-video-modal aria-hidden="true">
  <div class="vmodal__frame">
    <button class="vmodal__close" type="button" data-close-video aria-label="Close video">&times;</button>
    <video controls playsinline preload="none">
      {heroVideo && <source src={heroVideo} type="video/mp4" />}
    </video>
  </div>
</div>

<!-- WHAT WE DO — service cards -->
<section class="sec wwd-sec" style="background:#f5f5f5">
  <div class="wrap">
    <div class="wwd2__head" data-rv>
      <div>
        <span class="eyebrow">{home.wwd_eyebrow || "What We Do"}</span>
        <h2 class="h-lg wwd2__title">{home.wwd_heading} <span class="teal">{home.wwd_heading_accent}</span></h2>
      </div>
      <div class="wwd2__aside">
        <p class="body">{home.wwd_body}</p>
        <a class="btn3 btn3--teal" href="#">{home.wwd_cta_label || "Explore our capabilities"} <i data-lucide="arrow-right"></i></a>
      </div>
    </div>
    <div class="svc3__grid" data-rv-stagger>
      {services.map((s) => (
        <a class={`svc3 svc3--${s.color || "blue"}`} href={s.link || "#"}>
          <div class="svc3__img media"><img src={svcImg(s)} alt={s.title} /></div>
          <div class="svc3__panel">
            <span class="svc3__num">{s.num}</span>
            <h3 class="svc3__title" set:html={s.title}></h3>
            <p class="svc3__desc">{s.description}</p>
            <span class="svc3__arrow"><i data-lucide="arrow-right"></i></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- THE TRUTH -->
<section class="truth">
  <div class="truth__media" data-rv>
    <div class="media"><img src={truth1} alt="" /></div>
  </div>
  <div class="truth__text" data-rv>
    <span class="eyebrow">{home.truth_eyebrow || "The Truth"}</span>
    <h2 class="h-lg">{home.truth_heading}</h2>
    <div class="truth__body body" set:html={home.truth_body}></div>
  </div>
</section>

<!-- OUR PROCESS -->
<section class="process on-blue">
  <div class="wrap process__grid">
    <div data-rv>
      <span class="eyebrow">{home.process_eyebrow || "Our Process"}</span>
      <h2 class="h-lg" style="color:#fff;margin:16px 0 20px">{home.process_heading}</h2>
      <p class="body">{home.process_body}</p>
      <a class="btn3" href="#" style="margin-top:26px">{home.process_cta_label || "See how we work"} <i data-lucide="arrow-right"></i></a>
    </div>
    <div class="process__steps" data-rv-stagger>
      {steps.map((st) => (
        <div class="pstep">
          <div class="pstep__icon"><i data-lucide={st.icon || "circle"}></i></div>
          <span class="pstep__num">{st.num}</span>
          <h4 class="pstep__title">{st.title}</h4>
          <p class="pstep__desc">{st.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CLIENT LOGOS (sliding marquee) -->
<section class="logos sec" style="background:var(--v3-mist)">
  <div class="wrap logos__head" data-rv>
    <span class="eyebrow">{home.logos_eyebrow || "Selected Clients"}</span>
    <h2 class="h-lg" style="margin-top:12px">{home.logos_heading || "Real brands. Real impact."}</h2>
  </div>
  <div class="logos__viewport">
    <div class="logos__track">
      {[...logoLoop, ...logoLoop].map((l) => (
        <div class="logos__item">
          {l.image
            ? <img src={l.image} alt={l.name || "Client logo"} />
            : <span class="logos__word">{l.name}</span>}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="cta3 ctahome">
  <div class="wrap cta3__inner on-blue">
    <div class="ctahome__grid">
      <div data-rv>
        <span class="eyebrow">{home.cta_eyebrow || "Let's Build"}</span>
        <h2 class="h-xl cta3__title" style="margin-top:18px">{home.cta_lead_in || "Ready to build"} <span class="hero3__rot cta3__rot" id="cta-rot" data-words={JSON.stringify(ctaWords)}>{ctaWords[0]}</span> {home.cta_lead_out || "people love?"}</h2>
        <p class="body" style="margin-top:18px;max-width:44ch">{home.cta_body || "Let's talk."}</p>
        <a class="cta3__action" href="#" style="margin-top:26px">
          <span class="circ"><i data-lucide="arrow-right"></i></span>
          <span>{home.cta_button_label || "Start a Conversation"}</span>
        </a>
      </div>
      <div class="ctahome__figure" aria-hidden="true">
        <img src={home.cta_image || heroImg} alt="" />
      </div>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="foot3">
  <div class="wrap">
    <div class="foot3__main foot3__main--wide">
      <div>
        <a class="foot3__lockup" href="/"><img src="/assets/lockup-white.svg" alt="Fineries — We build brands people love" /></a>
        <div class="foot3__social">
          <a href={settings.social_linkedin || "#"} aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.76-2.05C20.4 8.65 21 11 21 14.1V21h-4v-6.1c0-1.45-.03-3.32-2.02-3.32-2.02 0-2.33 1.58-2.33 3.21V21H9z"/></svg></a>
          <a href={settings.social_instagram || "#"} aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></a>
          <a href={settings.social_x || "#"} aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.22-6.82-5.97 6.82H1.66l7.73-8.84L1.25 2.25h6.82l4.71 6.23zm-1.16 17.52h1.83L7.01 4.13H5.05z"/></svg></a>
        </div>
      </div>
      <div class="foot3__col">
        <h4>{settings.footer_services_heading || "What We Do"}</h4>
        {services.map((s) => <a href={s.link || "#"} set:html={s.title}></a>)}
      </div>
      <div class="foot3__col">
        <h4>{settings.footer_company_heading || "Company"}</h4>
        {companyLinks.map((l) => <a href={l.link || "#"}>{l.label}</a>)}
      </div>
      <div class="foot3__col">
        <h4>{settings.footer_contact_heading || "Get in Touch"}</h4>
        <p class="foot3__place">{settings.location}</p>
        {settings.address && <p class="foot3__addr">{settings.address}</p>}
        <a href={`mailto:${settings.contact_email}`}>{settings.contact_email}</a>
      </div>
    </div>
    <div class="foot3__bar">
      <span>&copy; <span data-year>2025</span> {settings.footer_copyright || "Fineries Digital Limited. All rights reserved."}</span>
      <span class="foot3__bar-links">{legalLinks.map((l) => <a href={l.link || "#"}>{l.label}</a>)}</span>
    </div>
  </div>
</footer>

</main>

<script src="/js/v3.js?v=25" is:inline defer></script>
</body>
</html>
