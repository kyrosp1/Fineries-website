---
import SiteNav from "./SiteNav.astro";
import SiteFooter from "./SiteFooter.astro";
import ServiceArtwork from "./ServiceArtwork.astro";
const { home = {}, settings = {}, services = [] } = Astro.props;

const ctaWords = home.cta_words && home.cta_words.length ? home.cta_words : ["a brand", "a product", "content"];
const heroImg = home.hero_image || "";
const wwdHeroImg = home.wwd_hero_image || heroImg;
const heroTags = (home.wwd_hero_tags && typeof home.wwd_hero_tags === "string")
  ? home.wwd_hero_tags.split(",").map((t) => t.trim()).filter(Boolean)
  : ["Brands", "Products", "People", "Possibilities"];

const navItems = (settings.nav_items && settings.nav_items.length) ? settings.nav_items : [
  { label: "Home", link: "/" },
  { label: "What We Do", link: "/what-we-do" },
  { label: "Work", link: "#" },
  { label: "About", link: "#" },
  { label: "Insights", link: "#" },
  { label: "Contact", link: "#" },
];
const companyLinks = (settings.footer_company_links && settings.footer_company_links.length) ? settings.footer_company_links : [
  { label: "About", link: "#" }, { label: "Work", link: "#" }, { label: "Insights", link: "#" }, { label: "Careers", link: "#" }, { label: "Contact", link: "#" },
];
const legalLinks = (settings.legal_links && settings.legal_links.length) ? settings.legal_links : [
  { label: "Privacy", link: "#" }, { label: "Terms", link: "#" },
];

// Fallback capability content (used when a service's CMS fields are empty), keyed by number.
const capData = {
  "01": {
    tagline: "Build a brand people understand, remember and choose.",
    overview: "We help organisations define who they are, where they belong and why people should care.",
    skills: ["Research & Insights", "Brand Strategy", "Brand Positioning", "Brand Architecture", "Brand Identity", "Visual Identity Systems", "Naming", "Brand Messaging", "Verbal Identity", "Brand Guidelines"],
    explore: "Explore Brand & Strategy", icon: "box",
  },
  "02": {
    tagline: "Turn attention into action.",
    overview: "We create integrated marketing programmes that help brands reach the right audiences, create demand and drive measurable growth.",
    skills: ["Marketing Strategy", "Campaign Strategy", "Digital Marketing", "Performance Advertising", "Social Media Marketing", "Influencer Marketing", "SEO", "Content Marketing", "Media Planning & Buying", "Campaign Management"],
    explore: "Explore Marketing & Growth", icon: "megaphone",
  },
  "03": {
    tagline: "Make something worth paying attention to.",
    overview: "From an idea on a page to something people watch, read, share and remember.",
    skills: ["Creative Direction", "Campaign Concepts", "Video Production", "Photography", "Motion Design", "Animation", "Social Content", "Copywriting", "Branded Content", "AI-assisted Content Production"],
    explore: "Explore Content & Production", icon: "play-circle",
  },
  "04": {
    tagline: "Build what the business needs next.",
    overview: "We design and build digital products, experiences and systems that help organisations serve customers better, operate more efficiently and create new opportunities.",
    skills: ["Websites", "Web Applications", "Mobile Applications", "Digital Platforms", "E-commerce", "Customer Portals", "Internal Tools", "Business Systems", "UI/UX Design", "AI Solutions", "Workflow Automation", "Systems Integration"],
    explore: "Explore Digital Products & Technology", icon: "monitor",
  },
  "05": {
    tagline: "Become known for what you know.",
    overview: "We help founders, executives and leaders turn their expertise and perspective into influence.",
    skills: ["Executive Positioning", "Personal Brand Strategy", "Thought Leadership", "Content Strategy", "LinkedIn Strategy", "Executive Content", "Visual Identity", "Reputation Building"],
    explore: "Explore Executive & Personal Branding", icon: "user",
  },
};
const capColor = { "01": "blue", "02": "gold", "03": "magenta", "04": "teal", "05": "blue" };

const fallbackCaps = [
  { num: "01", title: "Brand & Strategy", color: "blue", link: "/brand-and-strategy" },
  { num: "02", title: "Marketing & Growth", color: "gold", link: "/marketing-and-growth" },
  { num: "03", title: "Content & Production", color: "magenta", link: "/content-and-production" },
  { num: "04", title: "Digital Products & Technology", color: "teal", link: "/digital-and-tech" },
  { num: "05", title: "Executive & Personal Branding", color: "blue", link: "/executive-and-personal-branding" },
];
const capsRaw = (services && services.length) ? services : fallbackCaps;

const caps = capsRaw.map((s) => {
  const num = s.num || "01";
  const d = capData[num] || {};
  const skillsFromCms = typeof s.cap_skills === "string" && s.cap_skills.trim()
    ? s.cap_skills.split(/\r?\n/).map((x) => x.trim()).filter(Boolean)
    : null;
  return {
    num,
    title: s.title || "",
    color: s.color || capColor[num] || "blue",
    link: s.link || "#",
    icon: s.cap_icon || d.icon || "circle",
    image: s.image || "",
    tagline: s.cap_tagline || d.tagline || "",
    overview: s.cap_overview || d.overview || "",
    skills: skillsFromCms || d.skills || [],
    explore: s.cap_explore || d.explore || (s.title ? `Explore ${s.title}` : "Explore"),
  };
});

const pageTitle = home.wwd_seo_title || "What We Do | Fineries Digital";
const pageDesc = home.wwd_seo_description || "Brand & strategy, marketing & growth, content & production, digital products & technology, and executive branding — the capabilities Fineries brings together to solve the right problem.";
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={pageDesc} />
<link rel="icon" type="image/jpeg" href="/assets/fineries-favicon.jpg" />
<link rel="stylesheet" href="/css/v3.css?v=47" />
<link rel="stylesheet" href="/css/home.css?v=65" />
<link rel="stylesheet" href="/css/wwd.css?v=27" />
<script src="https://unpkg.com/lucide@latest" is:inline defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" is:inline defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" is:inline defer></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js" is:inline defer></script>
</head>
<body>

<SiteNav navItems={navItems} settings={settings} active="/what-we-do" />

<main id="main">

<!-- HERO (split: image + text on blue) -->
<section class="wwdhero">
  <div class="wwdhero__grid">
    <div class="wwdhero__media">
      {wwdHeroImg && <img src={wwdHeroImg} alt="" />}
      <ul class="wwdhero__tags" aria-hidden="true">
        {heroTags.map((t) => <li>{t}</li>)}
      </ul>
    </div>
    <div class="wwdhero__text on-blue" data-rv>
      <span class="eyebrow">{home.wwd_hero_eyebrow || "What We Do"}</span>
      <h1 class="wwdhero__title" set:html={home.wwd_hero_heading || "Different problems need different answers."}></h1>
      <div class="wwdhero__body">
        {home.wwd_hero_body
          ? <Fragment set:html={home.wwd_hero_body} />
          : (<>
              <p>Sometimes you need to rethink the brand. Sometimes you need to reach more people. Sometimes you need a campaign people can't ignore. Sometimes you need to build an entirely new product.</p>
              <p>We bring the capabilities together to help you figure out what needs to happen, then make it happen.</p>
            </>)}
      </div>
      <a class="btn3 btn3--solid wwdhero__cta" href="#capabilities">{home.wwd_hero_cta_label || "Explore our capabilities"} <i data-lucide="arrow-right"></i></a>
    </div>
  </div>
</section>

<!-- STRATEGY BEFORE SERVICES (blue band) -->
<section class="wwdstrat">
  <div class="wrap wwdstrat__grid on-blue" data-rv>
    <h2 class="h-lg wwdstrat__title" set:html={home.wwd_intro_heading || "Strategy before services."}></h2>
    <div class="wwdstrat__body">
      {home.wwd_intro_body
        ? <Fragment set:html={home.wwd_intro_body} />
        : (<>
            <p>We don't start by asking which service we can sell you. We start with the problem.</p>
            <p>What needs to change? What are we trying to achieve? Who are we trying to move? What's getting in the way?</p>
            <p class="wwdstrat__kicker">The answer determines what we do next.</p>
          </>)}
    </div>
  </div>
</section>

<!-- OUR CAPABILITIES (each artwork beside its copy; links to its page) -->
<section class="wwdcaps" id="capabilities">
  <div class="wrap">
    <div class="wwdcaps__head" data-rv>
      <h2 class="h-lg wwdcaps__heading">{home.wwd_caps_heading || "Our capabilities"}</h2>
      <span class="wwdcaps__tagline">{home.wwd_caps_tagline || "Five disciplines. One purpose."}</span>
    </div>
    <div class="wwdcaps__list">
      {caps.map((c, index) => (
        <article id={`capability-${c.num}`} class={`caprow2 caprow2--${c.color}${index % 2 === 1 ? " caprow2--rev" : ""}`} data-rv>
          <a class="caprow2__art" href={c.link || "#"} aria-label={`Explore ${c.title}`}>
            <ServiceArtwork num={c.num} title={c.title} fallback={c.image} />
          </a>
          <div class="caprow2__copy">
            <span class="caprow2__num">{c.num}</span>
            <h3 class="caprow2__title" set:html={c.title}></h3>
            <p class="caprow2__tagline">{c.tagline}</p>
            <p class="caprow2__overview">{c.overview}</p>
            <ul class="caprow2__skills">
              {c.skills.slice(0, 6).map((sk) => <li>{sk}</li>)}
              {c.skills.length > 6 && <li class="caprow2__more">+ {c.skills.length - 6} more</li>}
            </ul>
            <a class="caprow2__link" href={c.link}>
              <span>{c.explore}</span>
              <span class="caprow2__arrow"><i data-lucide="arrow-right"></i></span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- FINAL CTA (shared with home) -->
<section class="cta3 ctahome">
  <div class="wrap cta3__inner on-blue">
    <div class="ctahome__grid">
      <div data-rv>
        <span class="eyebrow">{home.cta_eyebrow || "Let's Build"}</span>
        <h2 class="h-xl cta3__title" style="margin-top:18px">{home.cta_lead_in || "Ready to build"} <span class="hero3__rot cta3__rot" id="cta-rot" data-words={JSON.stringify(ctaWords)}>{ctaWords[0]}</span> {home.cta_lead_out || "people love?"}</h2>
        <p class="body" style="margin-top:18px;max-width:44ch">{home.cta_body || "Let's talk."}</p>
        <a class="cta3__action" href="#" style="margin-top:26px">
          <span class="circ"><i data-lucide="arrow-right"></i></span>
          <span>{home.cta_button_label || "Start a Conversation"}</span>
        </a>
      </div>
      <div class="ctahome__figure" aria-hidden="true">
        <img src={home.cta_image || heroImg} alt="" />
      </div>
    </div>
  </div>
</section>

<SiteFooter settings={settings} services={services} companyLinks={companyLinks} legalLinks={legalLinks} />

</main>

<script src="/js/v3.js?v=25" is:inline defer></script>
</body>
</html>
