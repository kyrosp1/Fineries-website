---
import SiteNav from "./SiteNav.astro";
import SiteFooter from "./SiteFooter.astro";
import { resolveSubservices } from "../data/capabilities.js";

const { home = {}, settings = {}, services = [], page } = Astro.props;
const get = (name, fallback = "") => home[`${page.prefix}_${name}`] || fallback;
const ctaWords = home.cta_words?.length ? home.cta_words : ["a brand", "a product", "content"];
const heroImg = home.hero_image || "";
const mediaBase = "https://cms.fineries.net/wp-content/plugins/fineries-cms/assets/media";
const heroVideo = get("hero_video_desktop", `${mediaBase}/web-app-hero-landscape.mp4`);
const heroVideoMobile = get("hero_video_mobile", `${mediaBase}/web-app-hero-mobile.mp4`);
const heroPoster = get("hero_poster", `${mediaBase}/web-app-hero-poster.png`);
const pageServices = page.num ? resolveSubservices(services, page.num) : page.services;
const pageSteps = Array.isArray(home[`${page.prefix}_steps`]) && home[`${page.prefix}_steps`].length
  ? home[`${page.prefix}_steps`]
  : page.steps;

const navItems = settings.nav_items?.length ? settings.nav_items : [
  { label: "Home", link: "/" }, { label: "What We Do", link: "/what-we-do" },
  { label: "Work", link: "#" }, { label: "About", link: "#" },
  { label: "Insights", link: "#" }, { label: "Contact", link: "#contact" },
];
const companyLinks = settings.footer_company_links?.length ? settings.footer_company_links : [
  { label: "About", link: "#" }, { label: "Work", link: "#" }, { label: "Insights", link: "#" },
  { label: "Careers", link: "#" }, { label: "Contact", link: "#contact" },
];
const legalLinks = settings.legal_links?.length ? settings.legal_links : [
  { label: "Privacy", link: "#" }, { label: "Terms", link: "#" },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{get("seo_title", `${page.name} | Fineries Digital`)}</title>
  <meta name="description" content={get("seo_description", page.seoDescription)} />
  <link rel="icon" type="image/jpeg" href="/assets/fineries-favicon.jpg" />
  <link rel="stylesheet" href="/css/v3.css?v=51" />
  <link rel="stylesheet" href="/css/home.css?v=47" />
  <link rel="stylesheet" href="/css/capability-page.css?v=2" />
  <script src="https://unpkg.com/lucide@latest" is:inline defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" is:inline defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" is:inline defer></script>
  <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js" is:inline defer></script>
</head>
<body>
  <SiteNav navItems={navItems} settings={settings} active="/what-we-do" />
  <main id="main">
    <section class={`cphero cphero--${page.accent}`}>
      <div class="wrap cphero__inner on-blue">
        <div class="cphero__copy" data-rv>
          <span class="eyebrow">{get("hero_eyebrow", page.name)}</span>
          <h1 class="cphero__title">{get("hero_heading", page.heroHeading)}</h1>
          <div class="cphero__body body" set:html={get("hero_body", page.heroBody)}></div>
        </div>
        <button class="cphero__media" type="button" data-open-video aria-label={`Play ${page.name} video`} data-rv>
          <img src={heroPoster} alt="" aria-hidden="true" />
          <span class="cphero__shade" aria-hidden="true"></span>
          <span class="cphero__play" aria-hidden="true"><i data-lucide="play"></i></span>
          <span class="cphero__watch">Watch video</span>
        </button>
      </div>
    </section>

    <div class="vmodal" data-video-modal aria-hidden="true">
      <div class="vmodal__frame">
        <button class="vmodal__close" type="button" data-close-video aria-label="Close video">&times;</button>
        <video controls playsinline preload="none" poster={heroPoster} data-responsive-video data-desktop-src={heroVideo} data-mobile-src={heroVideoMobile}></video>
      </div>
    </div>

    <section class="sec cpintro">
      <div class="wrap cpintro__grid">
        <div data-rv>
          <span class="eyebrow">{get("intro_eyebrow", page.introEyebrow)}</span>
          <h2 class="h-lg cpintro__title">{get("intro_heading", page.introHeading)}</h2>
        </div>
        <div class="body cpintro__body" set:html={get("intro_body", page.introBody)} data-rv></div>
      </div>
    </section>

    <section class="sec cpservices">
      <div class="wrap">
        <div class="cpservices__head" data-rv>
          <span class="eyebrow">{get("services_eyebrow", "What We Do")}</span>
          <h2 class="h-lg">{get("services_heading", page.servicesHeading)}</h2>
        </div>
        <div class="cpservices__grid" data-rv-stagger>
          {pageServices.map((service, index) => (
            <article class="cpservice">
              <span class="cpservice__num">{String(index + 1).padStart(2, "0")}</span>
              <span class="cpservice__icon"><i data-lucide={service.icon || "circle"}></i></span>
              <h3>{service.title}</h3>
              {service.description && <p>{service.description}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class={`sec cpprinciple cpprinciple--${page.accent}`}>
      <div class="wrap cpprinciple__grid on-blue">
        <div data-rv>
          <span class="eyebrow">{get("principle_eyebrow", page.principleEyebrow)}</span>
          <h2 class="h-lg cpprinciple__title">{get("principle_heading", page.principleHeading)}</h2>
          <div class="body cpprinciple__body" set:html={get("principle_body", page.principleBody)}></div>
        </div>
        {pageSteps?.length > 0 && (
          <ol class="cpprinciple__steps" data-rv-stagger>
            {pageSteps.map((step, index) => (
              <li>
                <span class="cpprinciple__stepnum">{String(index + 1).padStart(2, "0")}</span>
                <div><h3>{step.title}</h3><p>{step.description}</p></div>
              </li>
            ))}
          </ol>
        )}
      </div>
    </section>

    <section class="cta3 ctahome" id="contact">
      <div class="wrap cta3__inner on-blue">
        <div class="ctahome__grid">
          <div data-rv>
            <span class="eyebrow">{home.cta_eyebrow || "Let's Build"}</span>
            <h2 class="h-xl cta3__title" style="margin-top:18px">{home.cta_lead_in || "Ready to build"} <span class="hero3__rot cta3__rot" id="cta-rot" data-words={JSON.stringify(ctaWords)}>{ctaWords[0]}</span> {home.cta_lead_out || "people love?"}</h2>
            <p class="body" style="margin-top:18px;max-width:44ch">{home.cta_body || "There is no better time than now."}</p>
            <a class="cta3__action" href="/contact#form" style="margin-top:26px"><span class="circ"><i data-lucide="arrow-right"></i></span><span>{home.cta_button_label || "Let's Talk"}</span></a>
          </div>
          <div class="ctahome__figure" aria-hidden="true"><img src={home.cta_image || heroImg} alt="" /></div>
        </div>
      </div>
    </section>
    <SiteFooter settings={settings} services={services} companyLinks={companyLinks} legalLinks={legalLinks} />
  </main>
  <script src="/js/v3.js?v=31" is:inline defer></script>
  <script is:inline>
    (() => {
      const mobile = window.matchMedia("(max-width: 800px)");
      const video = document.querySelector("video[data-responsive-video]");
      const selectVideo = () => {
        if (!video) return;
        const nextSrc = mobile.matches ? video.dataset.mobileSrc : video.dataset.desktopSrc;
        if (!nextSrc || video.getAttribute("src") === nextSrc) return;
        video.pause(); video.setAttribute("src", nextSrc); video.load();
      };
      selectVideo(); mobile.addEventListener("change", selectVideo);
    })();
  </script>
</body>
</html>
